{
  "name": "nextdo",
  "version": "0.1.6-beta.3",
  "private": true,
  "description": "Nextdo - GTD next-action assistant (monorepo root)",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify:web": "node scripts/verify-web.mjs",
    "check:version": "node scripts/check-release-version.mjs",
    "build:web": "pnpm --filter @nextdo/mobile build:web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
