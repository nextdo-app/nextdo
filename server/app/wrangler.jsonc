{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextdo-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
